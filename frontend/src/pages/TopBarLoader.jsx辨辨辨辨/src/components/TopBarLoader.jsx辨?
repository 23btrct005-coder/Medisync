import React, { useState, useEffect } from 'react';

const TopBarLoader = ({ isLoading }) => {
  const [progress, setProgress] = useState(0);

  useEffect(() => {
    let interval;
    if (isLoading) {
      setProgress(10);
      interval = setInterval(() => {
        setProgress((prev) => {
          if (prev >= 90) return prev;
          // Slowly increase to 90
          return prev + (90 - prev) * 0.1;
        });
      }, 200);
    } else {
      setProgress(100);
      setTimeout(() => setProgress(0), 300);
    }

    return () => clearInterval(interval);
  }, [isLoading]);

  if (progress === 0) return null;

  return (
    <div className="fixed top-0 left-0 w-full z-[9999] pointer-events-none">
      <div 
        className="h-1 bg-gradient-to-r from-primary-500 via-indigo-500 to-purple-500 transition-all duration-300 ease-out shadow-[0_0_10px_rgba(59,130,246,0.5)]"
        style={{ width: `${progress}%` }}
      />
    </div>
  );
};

export default TopBarLoader;
