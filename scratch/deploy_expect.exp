#!/usr/bin/expect -f
set timeout -1
set password "PVYZKN@etxcm588"
set ip "164.52.213.234"

# Step 1: SCP the script
spawn scp -o StrictHostKeyChecking=no deploy_medisync_pro.sh root@$ip:~/
expect {
    "*password:*" {
        send "$password\r"
    }
}
expect eof

# Step 2: SSH and run the script
spawn ssh -o StrictHostKeyChecking=no root@$ip "chmod +x ~/deploy_medisync_pro.sh && ./deploy_medisync_pro.sh"
expect {
    "*password:*" {
        send "$password\r"
    }
}
interact
