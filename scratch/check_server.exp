#!/usr/bin/expect -f
set timeout -1
set password "PVYZKN@etxcm588"
set ip "164.52.213.234"

spawn ssh -o StrictHostKeyChecking=no root@$ip "echo '--- SYSTEM STATUS ---' && uptime && echo '--- FIREWALL STATUS ---' && ufw status && echo '--- PROCESS STATUS ---' && netstat -tulpn | grep -E '8080|443|80' && echo '--- LAST 200 LOG LINES ---' && tail -n 200 ~/medisync_prod.log"
expect {
    "*password:*" {
        send "$password\r"
    }
}
interact
