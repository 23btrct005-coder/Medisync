#!/usr/bin/expect -f
set timeout -1
set password "PVYZKN@etxcm588"
set ip "164.52.213.234"

spawn ssh -o StrictHostKeyChecking=no root@$ip "rm -rf ~/Medisync/backend/target/*"
expect {
    "*password:*" {
        send "$password\r"
    }
}
expect eof

# Step 2: SCP the JAR and hardening script
spawn scp -o StrictHostKeyChecking=no backend/target/medisync-0.0.1-SNAPSHOT.jar root@$ip:~/Medisync/backend/target/
expect {
    "*password:*" {
        send "$password\r"
    }
}
expect eof

spawn scp -o StrictHostKeyChecking=no scratch/harden_server.sh root@$ip:~/
expect {
    "*password:*" {
        send "$password\r"
    }
}
expect eof

# Step 2: SSH, Restart and Harden
spawn ssh -o StrictHostKeyChecking=no root@$ip "cd ~/Medisync && fuser -k 8080/tcp || true && export \$(grep -v '^#' .env | xargs) && (nohup java -jar backend/target/medisync-0.0.1-SNAPSHOT.jar > ~/medisync_prod.log 2>&1 &) && sleep 2 && chmod +x ~/harden_server.sh && ~/harden_server.sh"
expect {
    "*password:*" {
        send "$password\r"
    }
}
interact
